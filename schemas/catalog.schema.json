{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iamsmmh.github.io/OmniSource/schemas/catalog.schema.json",
  "title": "OmniSource catalog",
  "description": "Hand-authored catalogue that describes what OmniSource distributes. scripts/omnisource.py turns this into AltStore-compatible feeds.",
  "type": "object",
  "required": ["source", "apps"],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": ["name", "identifier", "baseURL", "icon"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "identifier": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "owner": { "type": "string" },
        "repository": { "type": "string", "format": "uri" },
        "baseURL": { "type": "string", "format": "uri" },
        "tintColor": { "$ref": "#/definitions/hexColor" },
        "icon": { "type": "string" },
        "banner": { "type": "string" }
      }
    },
    "clients": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "icon", "url"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "icon": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/catalogApp" }
    }
  },
  "definitions": {
    "hexColor": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{6}$"
    },
    "versionString": {
      "type": "string",
      "minLength": 1
    },
    "fallbackDownloadURLs": {
      "type": "array",
      "description": "Ordered mirror URLs for the same build, tried when downloadURL is unavailable.",
      "items": { "type": "string", "format": "uri" },
      "uniqueItems": true
    },
    "catalogApp": {
      "type": "object",
      "required": [
        "slug",
        "name",
        "bundleIdentifier",
        "developerName",
        "icon",
        "status",
        "compatibility"
      ],
      "additionalProperties": true,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,31}$" },
        "name": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "bundleIdentifier": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" },
        "developerName": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "tintColor": { "$ref": "#/definitions/hexColor" },
        "icon": { "type": "string" },
        "localizedDescription": { "type": "string" },
        "screenshots": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "featured": { "type": "boolean" },
        "status": {
          "enum": ["stable", "beta", "manual", "unmaintained", "deprecated"]
        },
        "upstreamURL": { "type": "string", "format": "uri" },
        "sourceURL": {
          "type": "string",
          "format": "uri",
          "description": "Link of the source that actually publishes the sideload IPA (build fork, mirror repository or feed). Defaults to the upstream project page when unset."
        },
        "fallbackDownloadURLs": { "$ref": "#/definitions/fallbackDownloadURLs" },
        "verification": {
          "type": "object",
          "required": ["method", "publisher"],
          "additionalProperties": true,
          "properties": {
            "method": {
              "enum": [
                "github-release",
                "github-tag",
                "gitlab-release",
                "codeberg-release",
                "forgejo-release",
                "json-feed",
                "altstore",
                "feather",
                "manual-mirror",
                "self-built"
              ]
            },
            "publisher": { "type": "string", "minLength": 1 },
            "codeSigned": { "type": "boolean" },
            "checksumPublished": { "type": "boolean" }
          }
        },
        "compatibility": {
          "type": "object",
          "required": ["minOSVersion", "clients"],
          "additionalProperties": true,
          "properties": {
            "minOSVersion": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
            "maxOSVersion": {
              "anyOf": [
                { "type": "null" },
                { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" }
              ]
            },
            "devices": { "type": "array", "items": { "enum": ["iphone", "ipad"] } },
            "clients": {
              "type": "array",
              "items": { "enum": ["altstore", "sidestore", "flarestore", "feather", "esign", "ksign", "livecontainer"] }
            },
            "notes": { "type": "string" }
          }
        },
        "appPermissions": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "entitlements": { "type": "array", "items": { "type": "string" } },
            "privacy": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "upstream": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "github",
                "github-tags",
                "gitlab",
                "codeberg",
                "forgejo",
                "json-feed",
                "altstore",
                "feather"
              ],
              "description": "Source provider. Defaults to github."
            },
            "host": {
              "type": "string",
              "format": "uri",
              "description": "Forge origin for self-hosted GitLab/Forgejo, e.g. https://git.example.com"
            },
            "feedURL": {
              "type": "string",
              "format": "uri",
              "description": "Required for json-feed, altstore and feather providers."
            },
            "repo": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" },
            "appId": {
              "type": "string",
              "minLength": 1,
              "description": "Feed providers only: selects one app inside a multi-app feed by id, bundle identifier or name."
            },
            "tagPrefix": { "type": "string" },
            "excludeTagPrefixes": { "type": "array", "items": { "type": "string" } },
            "assetSuffixes": { "type": "array", "items": { "type": "string" } },
            "assetNamePattern": {
              "type": "string",
              "minLength": 1,
              "description": "Regular expression an asset filename must match to be eligible."
            },
            "versionPattern": {
              "type": "string",
              "minLength": 1,
              "description": "Regular expression selecting the published version number from the asset filename (then tag, then release name). The first capture group wins; remaining numbers stay available as {secondary}."
            },
            "maxPages": { "type": "integer", "minimum": 1 },
            "keepVersions": { "type": "integer", "minimum": 0 },
            "sortByTagNumber": { "type": "boolean" },
            "versionFromTag": {
              "type": "boolean",
              "description": "Read version numbers from the release tag instead of the asset name."
            },
            "descriptionTemplate": { "type": "string" },
            "minOSVersion": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
            "isoDates": {
              "type": "boolean",
              "description": "Emit full ISO 8601 UTC timestamps instead of date-only strings."
            },
            "minOSVersionByTagNumber": {
              "type": "object",
              "additionalProperties": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" }
            }
          }
        },
        "manualRelease": {
          "type": "object",
          "required": ["version", "date", "localizedDescription", "downloadURL", "size"],
          "additionalProperties": true,
          "properties": {
            "version": { "$ref": "#/definitions/versionString" },
            "date": { "$ref": "#/definitions/isoDate" },
            "localizedDescription": { "type": "string" },
            "downloadURL": { "type": "string", "format": "uri" },
            "size": { "type": "integer", "minimum": 1 },
            "minOSVersion": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
            "fallbackDownloadURLs": { "$ref": "#/definitions/fallbackDownloadURLs" }
          }
        }
      }
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([Tt ][0-9]{2}:[0-9]{2}(:[0-9]{2})?(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:?[0-9]{2})?)?$"
    }
  }
}
